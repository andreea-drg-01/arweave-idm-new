{
  "name": "arweave-idm",
  "version": "0.1.0",
  "description": "Prototype self-sovereign identity management on Arweave: DID documents on Arweave, ArNS resolution, BBS selective-disclosure credentials.",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "test": "node --test test/unit/ test/e2e/",
    "test:unit": "node --test test/unit/",
    "test:e2e": "node --test test/e2e/",
    "bench:crypto": "node bench/crypto.js",
    "mainnet:cost": "node scripts/mainnet/01-cost.js",
    "mainnet:latency": "node scripts/mainnet/02-gateway-latency.js",
    "mainnet:publish-did": "node scripts/mainnet/03-publish-did.js",
    "mainnet:arns": "node scripts/mainnet/04-arns-update.js",
    "mainnet:verify": "node scripts/mainnet/05-e2e-verify.js"
  },
  "dependencies": {
    "@ar.io/sdk": "latest",
    "@digitalbazaar/bbs-signatures": "latest",
    "arweave": "latest",
    "bs58": "latest"
  },
  "devDependencies": {
    "arlocal": "latest"
  }
}
